// ============================================================
// [C++/SIMD Backend] Generated by SNN Meta-Model
// Project: {{ model_name }} | Optimization: {{ power_mode }}
// LIF/IF dynamics standardized via src/lif_dynamics.py (decay/threshold/reset
// baked in as compile-time constants below, identical numerically to the
// values fed into the Python backends for the same metamodel spec).
//
// Build (MSVC, from a "x64 Native Tools Command Prompt"):
//   cl /O2 /fp:fast /arch:AVX2 /EHsc {{ model_name }}_CppSIMD.cpp /Fe:{{ model_name }}.exe
// Build (GCC/Clang):
//   g++ -O3 -march=native -ffast-math {{ model_name }}_CppSIMD.cpp -o {{ model_name }}
//
// Inner loops use restrict-qualified raw pointers and branch-free neuron
// updates so the compiler's auto-vectorizer can map them onto SIMD (AVX2)
// instructions without any hand-written intrinsics.
// ============================================================
#include <cstdio>
#include <vector>
#include <random>
#include <chrono>

{% for op in ops %}
{% if op.kind == 'neuron' %}
// LIF/IF layer: decay={{ "%.10f"|format(op.decay) }}, threshold={{ op.v_threshold }}, reset={{ op.v_reset }} ({{ op.reset_mechanism }})
static inline void {{ op.out_buf }}_neuron_update(float* __restrict v, const float* __restrict I, float* __restrict spk, int n) {
    constexpr float decay = {{ "%.10f"|format(op.decay) }}f;
    constexpr float threshold = {{ "%.10f"|format(op.v_threshold) }}f;
    for (int i = 0; i < n; ++i) {
        v[i] = decay * v[i] + I[i];
        float s = (v[i] >= threshold) ? 1.0f : 0.0f;
        spk[i] = s;
        {% if op.reset_mechanism == 'zero' %}
        v[i] = v[i] * (1.0f - s) + {{ "%.10f"|format(op.v_reset) }}f * s;
        {% else %}
        v[i] = v[i] - s * threshold; // soft reset (subtract)
        {% endif %}
    }
}
{% endif %}
{% endfor %}

static inline void linear_forward(const float* __restrict x, float* __restrict y,
                                   const float* __restrict W, const float* __restrict b,
                                   int in_f, int out_f) {
    for (int o = 0; o < out_f; ++o) {
        float acc = b[o];
        const float* w_row = W + (size_t)o * in_f;
        for (int k = 0; k < in_f; ++k) {
            acc += w_row[k] * x[k];
        }
        y[o] = acc;
    }
}

int main() {
    const int TIME_STEPS = {{ time_steps }};
    const int INPUT_FEATURES = {{ input_features }};

    std::mt19937 rng(42); // 재현성을 위한 고정 시드 (학습이 아닌 성능 측정이 목적)
    std::uniform_real_distribution<float> dist(-0.5f, 0.5f);

    // --- 버퍼 및 가중치 선언 ---
    std::vector<float> x_in(INPUT_FEATURES);
{% for op in ops %}
{% if op.kind == 'linear' %}
    std::vector<float> {{ op.weight_name }}((size_t){{ op.in_features }} * {{ op.out_features }});
    std::vector<float> {{ op.bias_name }}({{ op.out_features }});
    std::vector<float> {{ op.out_buf }}({{ op.out_features }});
{% else %}
    std::vector<float> {{ op.v_buf }}({{ op.width }}, 0.0f); // 막전위, 타임스텝 간 유지됨
    std::vector<float> {{ op.out_buf }}({{ op.width }});
{% endif %}
{% endfor %}

    // --- 가중치 초기화 (임의 초기화: 이 프로젝트의 목적은 학습된 정확도가 아니라
    //     레이턴시 측정이므로 학습 루프는 없음) ---
{% for op in ops %}
{% if op.kind == 'linear' %}
    for (auto& w : {{ op.weight_name }}) w = dist(rng);
    for (auto& b : {{ op.bias_name }}) b = dist(rng);
{% endif %}
{% endfor %}

    // --- 입력 데이터 사전 생성 (타이밍 측정 구간 밖에서 생성해 순수 추론 지연시간만 측정) ---
    std::vector<std::vector<float>> inputs(TIME_STEPS, std::vector<float>(INPUT_FEATURES));
    for (auto& row : inputs) {
        for (auto& v : row) v = dist(rng);
    }

    long long total_spikes = 0;

    auto t_start = std::chrono::high_resolution_clock::now();
    for (int t = 0; t < TIME_STEPS; ++t) {
        x_in = inputs[t];
{% for op in ops %}
{% if op.kind == 'linear' %}
        linear_forward({{ op.in_buf }}.data(), {{ op.out_buf }}.data(), {{ op.weight_name }}.data(), {{ op.bias_name }}.data(), {{ op.in_features }}, {{ op.out_features }});
{% else %}
        {{ op.out_buf }}_neuron_update({{ op.v_buf }}.data(), {{ op.in_buf }}.data(), {{ op.out_buf }}.data(), {{ op.width }});
{% endif %}
{% endfor %}
        for (float s : {{ ops[-1].out_buf }}) {
            if (s > 0.5f) total_spikes++;
        }
    }
    auto t_end = std::chrono::high_resolution_clock::now();

    double latency_ms = std::chrono::duration<double, std::milli>(t_end - t_start).count();

    std::printf("\n[CppSIMD] Model '%s' (power_mode=%s)\n", "{{ model_name }}", "{{ power_mode }}");
    std::printf(" - Time steps: %d | Output width: %d\n", TIME_STEPS, {{ output_width }});
    std::printf(" - Total spikes: %lld\n", total_spikes);
    std::printf(" - Latency: %.4f ms total | %.6f ms/step\n", latency_ms, latency_ms / TIME_STEPS);

    return 0;
}
