import torch
from bindsnet.network import Network
from bindsnet.network.nodes import LIFNodes, IFNodes, Input
from bindsnet.network.topology import Connection
from bindsnet.learning import PostPre, NoOp
from bindsnet.network.monitors import Monitor

"""
{{ '=' * 70 }}
SNN Meta-Model Framework (BindsNET Expert Ver. 2.0)
[Hardware-Aware Configuration]
- Mode: {{ power_mode }} | Target: {{ hardware_constraints.get('device_type', 'Neuromorphic Edge') }}
- Precision: {% if power_mode == 'low_energy' %}FP16 (Half){% else %}FP32 (Full){% endif %}
{{ '=' * 70 }}
"""

def create_{{ model_name }}(dt=1.0, is_learning=True):
    network = Network(dt=dt)
    power_mode = "{{ power_mode }}"
    
    # [Innovation] 학습 상태에 따른 가중치 업데이트 규칙 동적 할당
    learning_rule = PostPre if is_learning else NoOp

    # 1. Input Layer 정의 (SNN Spike Encoding 준비)
    input_layer = Input(n={{ layers[0].in_features }}, shape=({{ layers[0].in_features }},), sum_input=True)
    network.add_layer(input_layer, name="input_layer")

    prev_name = "input_layer"
    
    {% for l in layers[1:] %}
    {% if l.type in ['LIFNode', 'IFNode'] %}
    curr_name = "layer_{{ loop.index }}"
    
    # 2. [Hardware-Aware] 전력 모드에 따른 뉴런 모델 최적화 선택
    {% if power_mode == 'low_energy' %}
    # Low-Energy: 정수 기반 연산에 유리한 IF 모델 (No Leakage)
    curr_layer = IFNodes(n={{ l.out_features }}, sum_input=True)
    {% else %}
    # Standard: 시간적 해상도가 높은 LIF 모델 (Biological Fidelity)
    # thresh/rest/tc_decay는 표준 LIF 다이내믹스(src/lif_dynamics.py)에서 파생됨 (decay={{ l.decay }})
    curr_layer = LIFNodes(
        n={{ l.out_features }},
        sum_input=True,
        thresh={{ l.v_threshold }},
        rest={{ l.v_reset }},
        tc_decay={{ l.tau_mem }}
    )
    {% endif %}
    
    network.add_layer(curr_layer, name=curr_name)

    # 3. Connection 정의 (시냅스 연결 및 학습 규칙 적용)
    network.add_connection(
        Connection(
            source=network.layers[prev_name], 
            target=network.layers[curr_name], 
            update_rule=learning_rule
        ),
        source=prev_name, target=curr_name
    )
    
    # 4. [Innovation] 연구용 스파이크 분석 모니터 추가
    network.add_monitor(
        Monitor(network.layers[curr_name], state_vars=("s", "v"), time={{ time_steps }}),
        name=f"{curr_name}_monitor"
    )

    prev_name = curr_name
    {% endif %}
    {% endfor %}

    return network

if __name__ == "__main__":
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    model = create_{{ model_name }}(is_learning=True)
    model.to(device)

    # 5. [Optimization] 저전력 가동을 위한 FP16 양자화 전략
    {% if power_mode == 'low_energy' %}
    # BindsNET 텐서 내부 최적화 (Memory-Efficient Inference)
    for p in model.parameters():
        p.data = p.data.half()
    for layer in model.layers.values():
        if hasattr(layer, 'v'): layer.v = layer.v.half()
    print(">>> [System] FP16 Quantization Applied for Energy Efficiency.")
    {% endif %}

    # 시뮬레이션 데이터 준비 (Time, Batch, Features)
    data = torch.randn({{ time_steps }}, 1, {{ layers[0].in_features }}).to(device)
    {% if power_mode == 'low_energy' %}data = data.half(){% endif %}

    # 시뮬레이션 실행 (Research Execution)
    model.run(inputs={"input_layer": data}, time={{ time_steps }})

    # 결과 요약 출력
    print(f"\n{{ '=' * 50 }}")
    print(f"BindsNET Experiment Summary: '{{ model_name }}'")
    print(f" - Active Mode: {{ power_mode }}")
    print(f" - Computed Layers: {list(model.layers.keys())}")
    print(f" - Last Layer Spikes: {torch.sum(model.monitors[f'{prev_name}_monitor'].get('s')).item()}")
    print(f"{{ '=' * 50 }}")