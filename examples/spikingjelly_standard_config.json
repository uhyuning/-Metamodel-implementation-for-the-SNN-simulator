{
  "model_name": "SpikingJellyStandardModel",
  "target_simulator": "SpikingJelly",
  "time_steps": 100,
  "power_mode": "normal",
  "hardware_constraints": {
    "device_type": "high_performance_gpu"
  },
  "layers": [
    {
      "type": "linear",
      "in_features": 784,
      "out_features": 256
    },
    {
      "type": "LIFNode",
      "tau": 2.0,
      "v_threshold": 1.0,
      "v_reset": 0.0,
      "surrogate_function": "ATan",
      "note": "Standard Leaky Integrate-and-Fire with ATan"
    },
    {
      "type": "linear",
      "in_features": 256,
      "out_features": 10
    },
    {
      "type": "LIFNode",
      "tau": 2.0,
      "v_threshold": 1.0,
      "surrogate_function": "ATan"
    }
  ],
  "connections": [
    { "source": "input", "target": "layer_1" },
    { "source": "layer_1", "target": "layer_2" }
  ],
  "backend": "torch",
  "step_mode": "m"
}