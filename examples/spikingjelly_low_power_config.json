{
  "model_name": "SpikingJellyLowPowerModel",
  "target_simulator": "SpikingJelly",
  "time_steps": 40,
  "power_mode": "low_energy",
  "hardware_constraints": {
    "device_type": "edge_neuromorphic_processor"
  },
  "layers": [
    {
      "type": "linear",
      "in_features": 784,
      "out_features": 128
    },
    {
      "type": "IFNode",
      "v_threshold": 1.0,
      "v_reset": 0.0,
      "surrogate_function": "Sigmoid",
      "note": "Energy-efficient Integrate-and-Fire without Leakage"
    },
    {
      "type": "linear",
      "in_features": 128,
      "out_features": 10
    },
    {
      "type": "IFNode",
      "v_threshold": 1.0,
      "surrogate_function": "Sigmoid"
    }
  ],
  "connections": [
    { "source": "input", "target": "layer_1" },
    { "source": "layer_1", "target": "layer_2" }
  ],
  "backend": "torch",
  "step_mode": "m"
}